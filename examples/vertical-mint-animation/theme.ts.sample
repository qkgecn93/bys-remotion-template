// ============================================================
// theme.ts —— 全项目唯一的"控制台"
// 每期视频只需要改【每期必改】区；换风格只改【配色】区。
// 本底座风格：清透水感·薄荷绿（亮色清新，V2-rev 定稿）
// ============================================================

// ---------- 每期必改 ----------
export const DUR = 60; // 本期视频时长（秒），跑完字幕脚本后按最后一条字幕更新

// ---------- 画幅（竖屏抖音 9:16，初始化时定制，之后不动） ----------
export const FPS = 30;
export const WIDTH = 1080;
export const HEIGHT = 1920;

// ---------- 配色（换色只改这一块，所有底衬/描边走 accentRGB） ----------
// 亮色底座注意：文字是深墨绿，不是白色；弱字 textDim 只允许在白卡内部用。
export const theme = {
  bg: "#f6fbf9", // 全局背景（薄荷白）
  bgPanel: "#ffffff", // 白色卡片底
  panelBorder: "rgba(23,176,146,0.38)", // 卡片边框（2px 使用）
  text: "#123a33", // 主文字（深墨绿）
  text2: "#3f6b62", // 次级文字（深，可压在浅色装饰上）
  textDim: "#7d968f", // 弱文字——只允许在白色卡片内部用，禁止直接压在背景/素材上
  accent: "#17b092", // 主强调色（薄荷绿·加深版）
  accentDeep: "#0f9c81", // 白底上的高亮文字用它（比 accent 更深，保证清晰）
  accentSoft: "#a7e8db", // 辅助浅薄荷（只做装饰底衬，不做文字色）
  accentRGB: "23,176,146", // 供 rgba() 底衬/描边/投影用
  good: "#22c55e",
  bad: "#ef4444",
};

// 字体栈：中文优先思源黑体/苹方，无需额外安装
export const FONT =
  '"Source Han Sans SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif';
